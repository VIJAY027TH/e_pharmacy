# Production environment variables — loaded automatically by Vite during `npm run build`.
# The Vite dev proxy (vite.config.js) handles /api in local dev so this file is not used locally.
# In the Railway production build, VITE_API_URL must point to the live backend URL.
VITE_API_URL=https://epharmacy-production-ba7c.up.railway.app/api
